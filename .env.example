# Copy thành .env rồi điền key. .env đã nằm trong .gitignore, không commit.
# Biến đã đặt trong shell sẽ được ưu tiên hơn file này.
PROVIDER=openai
MODEL=gpt-6-luna
OPENAI_API_KEY=YOUR_KEY
# gpt-6-luna chỉ gọi được tools qua Chat Completions khi đặt none
REASONING_EFFORT=none
# GEMINI_API_KEY=YOUR_KEY
# ANTHROPIC_API_KEY=YOUR_KEY
# OPENROUTER_API_KEY=YOUR_KEY
